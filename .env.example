# Autoumyváreň Zemplín — environment variables (architecture §3.2)
# Copy to .env.local for local dev. NEVER commit real secrets (CLAUDE.md).

# --- Supabase ---
# Local: values printed by `supabase start`. Production: Supabase Cloud EU project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — privileged ops; bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-side only — mints short-lived Realtime JWTs (data-model §3.1).
SUPABASE_JWT_SECRET=

# --- SMS provider (spec 07) ---
# `fake` is the default and never sends real SMS — keep it in local dev and CI.
# `bulkgate` = BulkGate Simple Transactional API (the pinned provider).
SMS_PROVIDER=fake
# BulkGate application credentials (portal → Modules & APIs). Use a SEPARATE
# application for test and production: the delivery-report URL is configured per
# application, so sharing one would send production reports to the test box.
SMS_PROVIDER_APP_ID=
SMS_PROVIDER_API_KEY=
# Sender shown to the client. `gSystem` = BulkGate's shared system number (default).
# `gText` + SMS_SENDER_ID_VALUE = alphanumeric sender — needs registration for SK
# and cannot receive replies.
SMS_SENDER_ID=gSystem
SMS_SENDER_ID_VALUE=
# Webhook secret, verified by both callback routes (the two Route Handlers that
# bypass Cloudflare Access):
#   POST /api/sms/webhook                    → `x-sms-webhook-secret` header
#   POST /api/sms/webhook/bulkgate/<secret>  → path segment, because BulkGate's
#     callback cannot set custom headers. Use a long random value
#     (`openssl rand -hex 24`) — it ends up in access logs.
SMS_WEBHOOK_SECRET=dev-sms-webhook-secret
# Shared with pg_cron; verified in `POST /api/reminders`.
REMINDER_TRIGGER_SECRET=dev-reminder-secret
# Dev/test only: when 1, the `fake` adapter throws on phones ending in
# 999000000 so the e2e suite can exercise the dispatch failure path. NEVER
# set in production — a real customer phone could trip it.
SMS_FAKE_ALLOW_FAILURE=1

# --- Local-dev auth shim (architecture §2.2) ---
# INERT in production (hard-guarded). Leave UNSET in production.
DEV_AUTH_EMAIL=filicko203@gmail.com
# Optional dev role override. Applied ONLY when the identity comes from the dev
# shim (DEV_AUTH_EMAIL) — never when a real Cf-Access header is present (then the
# role comes from the staff table). Inert in production.
DEV_AUTH_ROLE=manazer
